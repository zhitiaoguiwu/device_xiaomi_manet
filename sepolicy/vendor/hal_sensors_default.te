# Screen-off UDFPS support in the manet QSH wrapper.
allow hal_sensors_default sysfs_touch_hostprocess:file { getattr open read };
allow hal_sensors_default touchfeature_device:chr_file { getattr ioctl open read write };
allowxperm hal_sensors_default touchfeature_device:chr_file ioctl { 0x5400 0x5403 };
